# Pawn Agent — Environment Variables
# Copy values into your real local env files as the app scaffold is introduced.
#
# Planned layout:
# - backend/.env          -> backend secrets and server runtime config
# - frontend/.env.local   -> frontend public config for local development
#
# This file is a shared reference template for the repository.

# =============================================================================
# CORE APP MODE
# =============================================================================
APP_ENV=development
LOG_LEVEL=info

# =============================================================================
# BACKEND SERVER
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# =============================================================================
# DATABASE
# =============================================================================
# SQLite is acceptable for local MVP development.
# Backend implementation may later support PostgreSQL without changing product scope.
DATABASE_URL=sqlite:///./pawn_agent.db

# =============================================================================
# ENCRYPTION / SECRET STORAGE
# =============================================================================
# Used to encrypt persisted merchant LLM API keys at rest.
# Generate a strong random key before real use.
PAWN_AGENT_MASTER_ENCRYPTION_KEY=

# =============================================================================
# LLM PROVIDER SUPPORT (MVP)
# =============================================================================
# Supported initial providers:
# - OpenAI
# - Anthropic
# - OpenRouter
#
# Merchants will store provider keys through the application UI/API.
# These env vars are optional for local testing, admin flows, or fallback development usage.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional default model hints for local development/testing
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1

# =============================================================================
# BASE SEPOLIA / WEB3
# =============================================================================
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_CHAIN_ID=84532

# Settlement/execution wallet for backend-controlled execution flows
EXECUTOR_PRIVATE_KEY=
EXECUTOR_WALLET_ADDRESS=

# Canonical buyout settlement contract address after deployment
BUYOUT_SETTLEMENT_CONTRACT_ADDRESS=

# =============================================================================
# MERCHANT WALLET / CDP AGENTIC WALLET
# =============================================================================
# Enable live provisioning against a locally authenticated `awal` session.
# If live mode is disabled or unavailable, backend can fall back to a deterministic stub.
PAWN_AGENT_CDP_WALLET_LIVE_ENABLED=false
PAWN_AGENT_CDP_WALLET_FALLBACK_TO_STUB=true
PAWN_AGENT_CDP_WALLET_CHAIN=base-sepolia
PAWN_AGENT_CDP_WALLET_CLI_COMMAND="npx awal"

# =============================================================================
# ENS / IDENTITY
# =============================================================================
# Canonical merchant identity is the root ENS name.
# Subdomain support is optional and may be added later.
ENS_REGISTRY_ADDRESS=
NAMESTONE_API_KEY=
DURIN_BASE_URL=

# =============================================================================
# FRONTEND PUBLIC CONFIG
# =============================================================================
# These will typically live in frontend/.env.local as NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=Pawn Agent
NEXT_PUBLIC_APP_URL=https://pawn.solovibing.com
# Frontend requests default to /api and Next proxies them to this backend URL.
# Prefer the server-only BACKEND_BASE_URL for deployed environments so browser calls stay same-origin.
# Keep NEXT_PUBLIC_BACKEND_BASE_URL only for edge cases where the browser must call the backend directly.
BACKEND_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_BASE_URL=
# Legacy alias still supported by the frontend code:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=84532
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_PAWN_TOKEN_ADDRESS=

# =============================================================================
# MARKET / PRICING INPUTS
# =============================================================================
# Optional external data providers for pricing and liquidity heuristics.
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com/latest
COINGECKO_API_KEY=
CHAINLINK_RPC_URL=

# =============================================================================
# SHOP / RULES DEFAULTS
# =============================================================================
# Legacy YAML-based rules examples may remain in config/ during transition,
# but the long-term product direction is app-managed structured rule storage.
SHOP_RULES_PATH=config/shop_rules.yaml
DEFAULT_SHOP_ENS_NAME=

# =============================================================================
# NOTIFICATIONS (OPTIONAL)
# =============================================================================
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# - Do not commit real secrets.
# - Merchant API keys should be stored encrypted through the backend, not in repo files.
# - AWS is not required for MVP secret storage.
# - Base Sepolia is the only target chain for MVP.
