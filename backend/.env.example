# Pawn Agent Backend — Environment Variables
# Copy this file to .env and fill in the values.

# Application
DEBUG=true
APP_NAME="Pawn Agent"

# Database (SQLite for local dev)
DATABASE_URL="sqlite+aiosqlite:///./pawn_agent.db"

# Master encryption key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# MUST be 32-byte hex string (64 hex characters)
MASTER_ENCRYPTION_KEY=""

# Base Sepolia RPC — get a free key at https://www.alchemy.com/
BASE_SEPOLIA_RPC_URL=""

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
