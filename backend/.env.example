# Pawn Agent Backend — Environment Variables
# Copy this file to .env and fill in the values.

# Application
DEBUG=true
APP_NAME="Pawn Agent"

# Database
# Local dev: SQLite
# DATABASE_URL="sqlite+aiosqlite:///./pawn_agent.db"
# Production: PostgreSQL + asyncpg
# DATABASE_URL="postgresql+asyncpg://pawnagent:password@db-host:5432/pawnagent"
DATABASE_URL="sqlite+aiosqlite:///./pawn_agent.db"

# Master encryption key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# MUST be 32-byte hex string (64 hex characters)
MASTER_ENCRYPTION_KEY=""

# Base Sepolia RPC — get a free key at https://www.alchemy.com/
BASE_SEPOLIA_RPC_URL=""

# Frontend URL(s) for CORS
FRONTEND_URL="http://localhost:3000"
# Optional extra allowed origins as a JSON array string, for example:
# FRONTEND_ORIGINS='["https://pawn.solovibing.com","https://frontend.vercel.app"]'
FRONTEND_ORIGINS='[]'

# Merchant wallet / CDP Agentic Wallet integration
CDP_WALLET_LIVE_ENABLED=false
CDP_WALLET_FALLBACK_TO_STUB=true
CDP_WALLET_CHAIN="base-sepolia"
CDP_WALLET_CLI_COMMAND="npx awal"

# Alchemy — replaces npx awal for live wallet mode on Base Sepolia.
# Get a free key at https://www.alchemy.com/
ALCHEMY_API_KEY=""
# Random seed (32+ chars) used to derive per-shop merchant private keys.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
ALCHEMY_WALLET_MASTER_SEED=""
